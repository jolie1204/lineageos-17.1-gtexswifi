new file mode 100644
index 0000000..f253b4e
--- /dev/null
+++ b/tools/capability-probe/capability_probe.c
@@ -0,0 +1,76 @@
+/* Runtime acceptance of Linux ambient capabilities used by Android init.
+ * Does not open sockets, touch devices, or persist credentials. Child only.
+ */
+#define _GNU_SOURCE
+#include <errno.h>
+#include <grp.h>
+#include <linux/capability.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/prctl.h>
+#include <sys/syscall.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+static int fail(const char *step) {
+    fprintf(stderr, "FAIL %s: %s\n", step, strerror(errno));
+    return 1;
+}
+
+static int verify_exec(void) {
+    struct __user_cap_header_struct h = { _LINUX_CAPABILITY_VERSION_3, 0 };
+    struct __user_cap_data_struct d[2] = {{0}};
+    const unsigned bit = 1U << CAP_NET_RAW;
+    if (getuid() != 2000 || geteuid() != 2000) return fail("child uid");
+    if (syscall(__NR_capget, &h, d) < 0) return fail("capget after exec");
+    if (d[0].effective != bit || d[0].permitted != bit || d[0].inheritable != bit ||
+        d[1].effective || d[1].permitted || d[1].inheritable) {
+        errno = EACCES; return fail("unexpected capability mask after exec");
+    }
+    if (prctl(PR_CAP_AMBIENT, PR_CAP_AMBIENT_IS_SET, CAP_NET_RAW, 0, 0) != 1)
+        return fail("ambient preserved across uid drop and exec");
+    errno = 0;
+    if (prctl(PR_CAP_AMBIENT, PR_CAP_AMBIENT_RAISE, CAP_SYS_ADMIN, 0, 0) != -1 ||
+        errno != EPERM) { errno = EACCES; return fail("unpermitted capability raise"); }
+    if (prctl(PR_CAP_AMBIENT, PR_CAP_AMBIENT_CLEAR_ALL, 0, 0, 0) != 0)
+        return fail("clear ambient");
+    if (prctl(PR_CAP_AMBIENT, PR_CAP_AMBIENT_IS_SET, CAP_NET_RAW, 0, 0) != 0)
+        return fail("ambient remains after clear");
+    puts("PASS uid=2000, exact capability mask survives exec, unauthorized raise rejected, clear works");
+    return 0;
+}
+
+int main(int argc, char **argv) {
+    if (argc == 2 && !strcmp(argv[1], "--verify-exec")) return verify_exec();
+    if (prctl(PR_CAP_AMBIENT, PR_CAP_AMBIENT_IS_SET, CAP_CHOWN, 0, 0) < 0)
+        return fail("ambient capability API unavailable");
+    if (getuid() != 0) {
+        puts("PASS ambient API present; uid-drop/exec test requires root");
+        return 2;
+    }
+    pid_t child = fork();
+    if (child < 0) return fail("fork");
+    if (!child) {
+        struct __user_cap_header_struct h = { _LINUX_CAPABILITY_VERSION_3, 0 };
+        struct __user_cap_data_struct d[2] = {{0}};
+        const unsigned bit = 1U << CAP_NET_RAW;
+        if (prctl(PR_SET_KEEPCAPS, 1, 0, 0, 0) < 0 || setgroups(0, NULL) < 0 ||
+            setgid(2000) < 0 || setuid(2000) < 0) _exit(fail("child uid drop"));
+        d[0].effective = d[0].permitted = d[0].inheritable = bit;
+        if (syscall(__NR_capset, &h, d) < 0) _exit(fail("set child masks"));
+        if (prctl(PR_CAP_AMBIENT, PR_CAP_AMBIENT_RAISE, CAP_NET_RAW, 0, 0) < 0)
+            _exit(fail("raise inherited capability"));
+        char self[4096];
+        ssize_t len = readlink("/proc/self/exe", self, sizeof(self)-1);
+        if (len <= 0 || len == (ssize_t)sizeof(self)-1) _exit(fail("self path"));
+        self[len] = '\0';
+        char *args[] = { self, "--verify-exec", NULL };
+        execv(self, args);
+        _exit(fail("exec child verifier"));
+    }
+    int status;
+    while (waitpid(child, &status, 0) < 0) if (errno != EINTR) return fail("wait child");
+    return WIFEXITED(status) ? WEXITSTATUS(status) : 1;
+}
