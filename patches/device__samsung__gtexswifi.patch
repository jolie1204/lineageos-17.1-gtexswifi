+TARGET_KERNEL_CLANG_COMPILE := false
+DEVICE_MANIFEST_FILE := $(LOCAL_PATH)/manifest.xml
+
+BOARD_ROOT_EXTRA_FOLDERS := efs productinfo preload
+
+# Android10 requires XML audio policy; legacy HAL is wrapped by audio@4.0.
+USE_XML_AUDIO_POLICY_CONF := 1
