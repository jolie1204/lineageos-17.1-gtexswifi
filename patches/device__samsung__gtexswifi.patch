diff --git a/libs/camera_cookie/rewrite_camera_cookie.py b/libs/camera_cookie/rewrite_camera_cookie.py
new file mode 100644
index 0000000..37420b5
--- /dev/null
+++ b/libs/camera_cookie/rewrite_camera_cookie.py
@@ -0,0 +1,103 @@
+#!/usr/bin/env python3
+"""Guarded, isolated SM-T280 legacy camera cookie and private-handle base ABI repair.
+No external dependencies. Does not modify input. No device operations.
+"""
+import argparse,hashlib,json,os,struct,tempfile
+from pathlib import Path
+EXPECTED_OUTPUT_SHA="21c66b05e3bf4183396582c5ec2a9ad7421a0cc24fa0309d6021270f0a73e158"
+ORIGINAL_SHA="0bfbb8eb5db3cbe596b97d0a81bcaca9102728e2ab6d17e7e7cf8e335040cee7"
+TAIL=0x130fa0
+
+def sha(b): return hashlib.sha256(b).hexdigest()
+def bl(site,target):
+    delta=target-(site+4)
+    assert delta%2==0 and -(1<<24)<=delta<(1<<24)
+    v=delta&0x1ffffff; s=(v>>24)&1; i1=(v>>23)&1; i2=(v>>22)&1
+    return struct.pack("<HH",0xf000|(s<<10)|((v>>12)&0x3ff),0xd000|((1^(i1^s))<<13)|((1^(i2^s))<<11)|((v>>1)&0x7ff))
+def main():
+    ap=argparse.ArgumentParser();ap.add_argument("--input",required=True);ap.add_argument("--output",required=True);ap.add_argument("--proof",required=True);ap.add_argument("--trampoline-object",required=True);args=ap.parse_args()
+    if not __debug__: raise RuntimeError("Python optimization disables structural guards")
+    src=Path(args.input);dst=Path(args.output)
+    proofpath=Path(args.proof);assert proofpath.resolve()!=src.resolve() and proofpath.resolve()!=dst.resolve()
+    assert src.resolve()!=dst.resolve(), "input is immutable"
+    raw=src.read_bytes();assert sha(raw)==ORIGINAL_SHA,"unknown original"
+    assert raw[:7]==b"\x7fELF\x01\x01\x01"
+    b=bytearray(raw); phoff=struct.unpack_from("<I",b,28)[0];entsz,num=struct.unpack_from("<HH",b,42)
+    assert entsz==32
+    ph=[struct.unpack_from("<8I",b,phoff+i*32) for i in range(num)]
+    rx=[(i,h) for i,h in enumerate(ph) if h[0]==1 and h[6]==5]
+    assert len(rx)==1
+    pi,h=rx[0];assert h[1]==0 and h[2]==0 and h[4]==TAIL and h[5]==TAIL
+    stubs={
+      "metadata":bytes.fromhex("0822 d4f85c37 2847"),
+      "alloc":bytes.fromhex("0023 d8f85c37 3047"),
+      "raw":bytes.fromhex("0023 d4f85c37 3847"),
+      "jpeg_fd":bytes.fromhex("4ff0ff30 d6f85c37 7047"),
+      "raw_jpeg":bytes.fromhex("0023 d6f85c37 2047"),
+    }
+    addresses={};tail=bytearray()
+    for name,code in stubs.items():addresses[name]=TAIL+len(tail);tail+=code
+    # Require the build's real assembled Thumb source to match reviewed bytes.
+    obj=Path(args.trampoline_object).read_bytes()
+    assert obj[:7]==b"\x7fELF\x01\x01\x01" and struct.unpack_from("<H",obj,18)[0]==40
+    shoff=struct.unpack_from("<I",obj,32)[0];shents,shnum,shstr=struct.unpack_from("<HHH",obj,46);assert shents==40
+    sections=[struct.unpack_from("<10I",obj,shoff+i*shents) for i in range(shnum)]
+    sn=sections[shstr];strings=obj[sn[4]:sn[4]+sn[5]]
+    ts=[q for q in sections if strings[q[0]:].split(b"\0",1)[0]==b".text"];assert len(ts)==1
+    q=ts[0];assert obj[q[4]:q[4]+q[5]]==tail,"assembled trampoline differs from reviewed bytes"
+    assert len(tail)==42 and raw[TAIL:TAIL+len(tail)]==bytes(len(tail))
+    for j,q in enumerate(ph):
+        if q[0]==1 and j!=pi:
+            assert h[2]+TAIL+len(tail)<=q[2] or q[2]+q[5]<=h[2]
+            assert TAIL+len(tail)<=q[1] or q[1]+q[4]<=h[1]
+    sites=[
+      (0x2e3d0,"0822a847","metadata","r4",0x2e3d4),
+      (0x3161c,"0023b047","alloc","r8",0x31620),
+      (0x35a00,"0023b847","raw","r4",0x35a04),
+      (0x37bd6,"4ff0ff30","jpeg_fd","r6",0x37bda),
+      (0x37c2c,"4ff0ff30","jpeg_fd","r6",0x37c30),
+      (0x37d00,"0023a047","raw_jpeg","r6",0x37d04),
+    ]
+    records=[]
+    for site,old,name,owner,ret in sites:
+        assert raw[site:site+4]==bytes.fromhex(old),hex(site)
+        replacement=bl(site,addresses[name]);b[site:site+4]=replacement
+        records.append(dict(site=hex(site),original=old,replacement=replacement.hex(),stub=name,owner=owner,cookie_offset="0x75c",return_address=hex(ret|1)))
+    base_sites=[
+      (0x30e4e,"2a6a","2a6b","r5","r2"),
+      (0x30e96,"2b6a","2b6b","r5","r3"),
+      (0x30ea8,"286a","286b","r5","r0"),
+      (0x30eb6,"296a","296b","r5","r1"),
+      (0x325ee,"336a","336b","r6","r3"),
+      (0x3263e,"316a","316b","r6","r1"),
+      (0x32648,"326a","326b","r6","r2"),
+    ]
+    base_records=[]
+    for site,old,new,owner,dest in base_sites:
+        assert raw[site:site+2]==bytes.fromhex(old),hex(site)
+        b[site:site+2]=bytes.fromhex(new)
+        base_records.append(dict(site=hex(site),original=old,replacement=new,handle_register=owner,destination_register=dest,old_offset="0x20",new_offset="0x30",instruction="16-bit Thumb LDR immediate; flags/SP/LR unchanged"))
+    b[TAIL:TAIL+len(tail)]=tail
+    for field in (16,20):struct.pack_into("<I",b,phoff+pi*32+field,TAIL+len(tail))
+    allowed=[(a,a+4) for a,*_ in sites]+[(a,a+2) for a,*_ in base_sites]+[(TAIL,TAIL+len(tail)),(phoff+pi*32+16,phoff+pi*32+24)]
+    changed=[i for i,(x,y) in enumerate(zip(raw,b)) if x!=y]
+    assert len(raw)==len(b) and all(any(lo<=i<hi for lo,hi in allowed) for i in changed)
+    assert (TAIL-1)//4096==(TAIL+len(tail)-1)//4096,"new RX page mapping"
+    assert sha(b)==EXPECTED_OUTPUT_SHA,"unexpected transform result"
+    dst.parent.mkdir(parents=True,exist_ok=True)
+    fd,tmp=tempfile.mkstemp(prefix=dst.name+".",dir=dst.parent)
+    try:
+        with os.fdopen(fd,"wb") as f:f.write(b);f.flush();os.fchmod(f.fileno(),0o644);os.fsync(f.fileno())
+        os.replace(tmp,dst)
+    finally:
+        if os.path.exists(tmp):os.unlink(tmp)
+    proof=json.dumps(dict(original_sha256=sha(raw),candidate_sha256=sha(b),size=len(b),changed_bytes=len(changed),rx_old_size=hex(TAIL),rx_new_size=hex(TAIL+len(tail)),stub_addresses={k:hex(v) for k,v in addresses.items()},sites=records,base_sites=base_records,allowed_change_ranges=[[hex(a),hex(z)] for a,z in allowed],limitation="Tail stubs have no dedicated ARM exidx entries; ordinary callback LR stays at original caller. No on-device proof."),indent=2)
+    proofpath.parent.mkdir(parents=True,exist_ok=True)
+    fd,tmp=tempfile.mkstemp(prefix=proofpath.name+".",dir=proofpath.parent)
+    try:
+        with os.fdopen(fd,"w") as f:f.write(proof+"\n");f.flush();os.fchmod(f.fileno(),0o644);os.fsync(f.fileno())
+        os.replace(tmp,proofpath)
+    finally:
+        if os.path.exists(tmp):os.unlink(tmp)
+    print(proof)
+if __name__=="__main__":main()
