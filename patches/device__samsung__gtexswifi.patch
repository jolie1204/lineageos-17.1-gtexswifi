@@ -0,0 +1,20 @@
+#!/usr/bin/env python3
+"""Export only the legacy Spreadtrum userspace ABI headers, using the kernel sanitizer."""
+import argparse,subprocess,json,hashlib
+from pathlib import Path
+ap=argparse.ArgumentParser(description=__doc__)
+ap.add_argument('--kernel-source',type=Path,required=True)
+ap.add_argument('--kernel-out',type=Path,required=True)
+ap.add_argument('--cross-compile',required=True)
+ap.add_argument('--host-cc',type=Path,required=True)
+a=ap.parse_args();src=a.kernel_source.resolve();out=a.kernel_out.resolve()
+make=Path('prebuilts/build-tools/linux-x86/bin/make').resolve()
+subprocess.run([str(make),'-C',str(src),'O='+str(out),'ARCH=arm','CROSS_COMPILE='+a.cross_compile,'HOSTCC='+str(a.host_cc.resolve()),'HOSTCFLAGS=-fuse-ld=lld','HOSTLDFLAGS=-fuse-ld=lld','__headers'],check=True)
+items=[('video',['ion_sprd.h','sprd_vsp.h','sprd_jpg.h','gsp_types_shark.h','gspn_user_cfg.h','sprd_fb.h'],src/'include/video'),('linux',['ion.h'],src/'include/uapi/linux')]
+records=[]
+for sub,names,origin in items:
+ dest=out/'usr/include'/sub;dest.mkdir(parents=True,exist_ok=True)
+ subprocess.run(['bash',str(src/'scripts/headers_install.sh'),str(dest),str(origin),*names],cwd=out,check=True)
+ for name in names:records.append({'header':sub+'/'+name,'sha256':hashlib.sha256((dest/name).read_bytes()).hexdigest()})
+(out/'usr/.sprd_headers.stamp').write_text(json.dumps(records,indent=2)+'\n')
+print('Exported',len(records),'sanitized vendor ABI headers; standard platform UAPI untouched.')
