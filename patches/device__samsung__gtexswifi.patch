diff --git a/libs/ynoise_pic/rewrite_ynoise_pic.py b/libs/ynoise_pic/rewrite_ynoise_pic.py
new file mode 100644
index 0000000..fbbe977
--- /dev/null
+++ b/libs/ynoise_pic/rewrite_ynoise_pic.py
@@ -0,0 +1,95 @@
+#!/usr/bin/env python3
+"""Guarded PIC conversion of one legacy CRT finalizer; never edits canonical input."""
+from pathlib import Path
+import hashlib,struct,json,argparse,os,tempfile
+if not __debug__:
+ raise SystemExit("Assertions must remain enabled; do not use python -O")
+a=argparse.ArgumentParser(description=__doc__)
+a.add_argument("--input",type=Path,required=True)
+a.add_argument("--output",type=Path,required=True)
+a.add_argument("--proof",type=Path,required=True)
+a.add_argument("--prefix-object",type=Path,required=True)
+args=a.parse_args()
+source=args.input;output=args.output;proof=args.proof
+assert len({source.resolve(),output.resolve(),proof.resolve(),args.prefix_object.resolve()})==4
+old=source.read_bytes();expected='dde84e73d2f87bbf918be043111884e52a3dbd1a65e581447ff6e9e4796bdbcb';sha=lambda x:hashlib.sha256(x).hexdigest();assert sha(old)==expected,"Unexpected original proprietary blob SHA256"
+
+U=lambda b,o:struct.unpack_from('<I',b,o)[0]
+def sections(b):
+ shoff=U(b,32);size,n,strings=struct.unpack_from('<HHH',b,46);assert size==40
+ rows=[list(struct.unpack_from('<IIIIIIIIII',b,shoff+i*size)) for i in range(n)];s=rows[strings];names=b[s[4]:s[4]+s[5]];out={}
+ for i,r in enumerate(rows):
+  name=names[r[0]:].split(b'\0',1)[0].decode();out[name]={'header':shoff+i*40,'type':r[1],'flags':r[2],'va':r[3],'offset':r[4],'size':r[5],'link':r[6],'entry_size':r[9]}
+ return out
+assert old[:6]==b'\x7fELF\x01\x01' and struct.unpack_from('<H',old,18)[0]==40
+S=sections(old);phoff=U(old,28);phsize,phnum=struct.unpack_from('<HH',old,42);P=[struct.unpack_from('<IIIIIIII',old,phoff+i*phsize) for i in range(phnum)]
+def seg(va):return next(p for p in P if p[0]==1 and p[2]<=va<p[2]+p[5])
+def off(va):p=seg(va);assert va<p[2]+p[4];return p[1]+va-p[2]
+syms={};ss=S['.dynstr'];st=old[ss['offset']:ss['offset']+ss['size']];ss=S['.dynsym']
+for o in range(ss['offset'],ss['offset']+ss['size'],16):
+ name,value,size,info,other,index=struct.unpack_from('<IIIBBH',old,o);syms[st[name:].split(b'\0',1)[0].decode()]={'value':value,'size':size}
+glue=syms['__on_dlclose']['value'];dso=syms['__dso_handle']['value'];assert glue==0x1404 and dso==0x3010 and syms['__on_dlclose']['size']==12
+slot=glue+12;assert slot==0x1410 and U(old,off(slot))==dso
+assert old[off(glue):off(glue)+12]==bytes.fromhex('04008fe2000090e53efdffea')
+rel=S['.rel.dyn'];rels=[struct.unpack_from('<II',old,o) for o in range(rel['offset'],rel['offset']+rel['size'],8)];assert len(rels)==7
+readonly=[r for r in rels if not(seg(r[0])[6]&2)];assert readonly==[(slot,23)],readonly
+kept=[r for r in rels if r!=(slot,23)];assert len(kept)==6 and kept==rels[1:]
+# Obtain the real ARM-assembled two-instruction prefix, not a handwaved replacement.
+obj=args.prefix_object.read_bytes();sec=sections(obj)['.text'];prefix=obj[sec['offset']:sec['offset']+sec['size']];assert prefix==bytes.fromhex('070b8fe2040080e2')
+new=bytearray(old);go=off(glue);new[go:go+8]=prefix
+blob=b''.join(struct.pack('<II',*r) for r in kept);new[rel['offset']:rel['offset']+rel['size']]=blob+b'\0'*8;struct.pack_into('<I',new,rel['header']+20,len(blob))
+# Dynamic allocation/layout stays fixed; compact valid entries and extend NULL padding.
+dyn=S['.dynamic'];entries=[]
+for o in range(dyn['offset'],dyn['offset']+dyn['size'],8):
+ tag,val=struct.unpack_from('<II',old,o)
+ if tag==0:
+  assert not any(old[o:dyn['offset']+dyn['size']]);break
+ entries.append((tag,val))
+assert entries.count((22,0))==1 and (18,56) in entries and (0x6ffffffa,6) in entries
+updated=[]
+for tag,val in entries:
+ if tag==22:continue
+ if tag==18:val=len(blob)
+ if tag==0x6ffffffa:val=5
+ if tag==30:
+  assert val&4;val &= ~4
+ updated.append((tag,val))
+dynbytes=b''.join(struct.pack('<II',*x) for x in updated)+b'\0'*8;assert len(dynbytes)<=dyn['size'];new[dyn['offset']:dyn['offset']+dyn['size']]=dynbytes+b'\0'*(dyn['size']-len(dynbytes))
+assert len(new)==len(old)
+# Check actual instruction encodings preserve registers, condition flags, LR and final tailcall.
+def ror(x,n):return ((x>>n)|(x<<(32-n if n else 32)))&0xffffffff
+w0,w1=struct.unpack('<II',prefix)
+for w,rn in [(w0,15),(w1,0)]:
+ assert (w>>28)==14 and ((w>>25)&7)==1 and ((w>>21)&15)==4 and not(w&(1<<20)) and ((w>>16)&15)==rn and ((w>>12)&15)==0
+imm0=ror(w0&255,((w0>>8)&15)*2);imm1=ror(w1&255,((w1>>8)&15)*2);assert imm0==0x1c00 and imm1==4
+samples=[]
+for base in [0,0x10000,0x12345000,0x80000000,0xb6a00000,0xffff0000]:
+ original=(base+dso)&0xffffffff;replacement=(base+glue+8+imm0+imm1)&0xffffffff;assert original==replacement;samples.append({'base':hex(base),'old_r0_after_text_relocation':hex(original),'new_pic_r0':hex(replacement)})
+assert (glue+8+imm0+imm1)==dso
+assert new[go+8:go+12]==old[go+8:go+12]  # same unconditional B, not BL; LR/stack untouched
+text=S['.text'];alg_start=text['offset'];alg_end=go;assert old[alg_start:alg_end]==new[alg_start:alg_end]
+for name in ['.dynsym','.dynstr','.plt','.ARM.exidx','.rodata','.init_array','.fini_array','.got']:
+ s=S[name];assert new[s['offset']:s['offset']+s['size']]==old[s['offset']:s['offset']+s['size']]
+assert old[phoff:phoff+phnum*phsize]==new[phoff:phoff+phnum*phsize]
+allowed=[(go,go+8),(rel['offset'],rel['offset']+rel['size']),(rel['header']+20,rel['header']+24),(dyn['offset'],dyn['offset']+dyn['size'])]
+changed=[i for i,(a,b) in enumerate(zip(old,new)) if a!=b];assert all(any(a<=i<b for a,b in allowed) for i in changed)
+ranges=[]
+for i in changed:
+ if ranges and ranges[-1][1]==i:ranges[-1][1]=i+1
+ else:ranges.append([i,i+1])
+assert sha(new)=='46fbcee51adc04d434cce3988e64c066ad5f46cc4daa865e9cb137e6d5d04dd5', 'Unexpected transformed output SHA256'
+assert sha(source.read_bytes())==expected, 'Input changed during transform'
+output.parent.mkdir(parents=True,exist_ok=True);proof.parent.mkdir(parents=True,exist_ok=True)
+def atomic_write(path, data):
+ # Same-directory unique temporary file permits rebuilding an existing output.
+ # No write is attempted against the destination inode (which may be readonly).
+ fd, temporary = tempfile.mkstemp(prefix=path.name+".",suffix=".tmp",dir=str(path.parent))
+ try:
+  with os.fdopen(fd,"wb") as stream:
+   stream.write(data);stream.flush();os.fsync(stream.fileno());os.fchmod(stream.fileno(),0o644)
+  os.replace(temporary,path)
+ finally:
