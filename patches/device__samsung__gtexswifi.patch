diff --git a/libs/ynoise_pic/Android.mk b/libs/ynoise_pic/Android.mk
new file mode 100644
index 0000000..c3af987
--- /dev/null
+++ b/libs/ynoise_pic/Android.mk
@@ -0,0 +1,37 @@
+LOCAL_PATH := $(call my-dir)
+
+# Device-scoped output; original proprietary source is never modified.
+gtex_ynoise_dir := $(LOCAL_PATH)
+gtex_ynoise_gen := $(call intermediates-dir-for,SHARED_LIBRARIES,libynoise_gtex_pic)/pic
+gtex_ynoise_input := vendor/samsung/gtexswifi/proprietary/lib/libynoise.so
+# Use the compiler ELF, avoiding the legacy Python2 wrapper on modern hosts.
+gtex_ynoise_clang := prebuilts/clang/host/linux-x86/clang-r353983c1/bin/clang.real
+
+define gtex-build-ynoise-prefix
+@mkdir -p $(dir $@)
+$(PRIVATE_CLANG) --target=armv7a-linux-androideabi29 -march=armv7-a -c $< -o $@
+endef
+$(gtex_ynoise_gen)/crt-glue.o: PRIVATE_CLANG := $(gtex_ynoise_clang)
+$(gtex_ynoise_gen)/crt-glue.o: $(gtex_ynoise_dir)/crt-glue.S $(gtex_ynoise_clang)
+	$(gtex-build-ynoise-prefix)
+
+$(gtex_ynoise_gen)/libynoise.so: PRIVATE_TOOL := $(gtex_ynoise_dir)/rewrite_ynoise_pic.py
+$(gtex_ynoise_gen)/libynoise.so: PRIVATE_INPUT := $(gtex_ynoise_input)
+$(gtex_ynoise_gen)/libynoise.so: PRIVATE_PREFIX := $(gtex_ynoise_gen)/crt-glue.o
+$(gtex_ynoise_gen)/libynoise.so: .KATI_IMPLICIT_OUTPUTS := $(gtex_ynoise_gen)/proof.json
+$(gtex_ynoise_gen)/libynoise.so: $(gtex_ynoise_input) $(gtex_ynoise_dir)/rewrite_ynoise_pic.py $(gtex_ynoise_gen)/crt-glue.o
+	python3 $(PRIVATE_TOOL) --input $(PRIVATE_INPUT) --output $@ --proof $(dir $@)proof.json --prefix-object $(PRIVATE_PREFIX)
+
+include $(CLEAR_VARS)
+LOCAL_MODULE := libynoise_gtex_pic
+LOCAL_MODULE_CLASS := SHARED_LIBRARIES
+LOCAL_MODULE_TAGS := optional
+LOCAL_MODULE_STEM := libynoise
+LOCAL_MODULE_SUFFIX := .so
+LOCAL_MULTILIB := 32
+LOCAL_MODULE_PATH := $(TARGET_OUT_SHARED_LIBRARIES)
+LOCAL_PREBUILT_MODULE_FILE := $(gtex_ynoise_gen)/libynoise.so
+# Preserve the reviewed bytes through installation.
+LOCAL_STRIP_MODULE := false
+LOCAL_SHARED_LIBRARIES := liblog libbinder libutils libcutils libui libc libstdc++ libm
+include $(BUILD_PREBUILT)
