+void CameraDevice::cleanupBridgeIdlePools(bool closing) {
+    std::vector<std::shared_ptr<BridgePool>> drained;
+    sp<ICameraDeviceCallback> oldCallback;
+    {
+        Mutex::Autolock lock(mBridgeLock);
+        if(closing) {oldCallback=mBridgeCallback;mBridgeCallback=nullptr;}
+        if(closing || !mBridgeConfigured) {
+            auto it=mBridgePools.begin();
+            while(it!=mBridgePools.end()) {
+                bool busy=false;for(bool value:(*it)->busy) busy|=value;
+                if((*it)->retired && !busy) {
