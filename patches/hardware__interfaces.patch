+             detached.swap(mBridgePools);mBridgeMemoryIds.clear();mBridgeCallback=nullptr;}
+            mHalPreviewWindow.cleanUpCirculatingBuffers();
+            {Mutex::Autolock windowLock(mHalPreviewWindow.mLock);
+             oldPreview=mHalPreviewWindow.mPreviewCallback;mHalPreviewWindow.mPreviewCallback=nullptr;}
+        }
+        // Client IMemory retains its own heap FD; close cancels all old vendor leases.
+        // Unregister/drop all owned registrations outside locks, including copied busy slots.
+        return Void();
+    }
+    { Mutex::Autolock _l(mLock); closeLocked(); }
     return Void();
 }
 
 void CameraDevice::closeLocked() {
     ALOGI("Closing camera %s", mCameraId.c_str());
     if(mDevice) {
+        if(mBridgeEnabled) {
+            retireBridge();
+            if(mDevice->ops->disable_msg_type) mDevice->ops->disable_msg_type(mDevice,CAMERA_MSG_VIDEO_FRAME);
+            drainBridge();
+            if(mBridgeConfigured && mDevice->ops->stop_recording) mDevice->ops->stop_recording(mDevice);
+        }
         int rc = mDevice->common.close(&mDevice->common);
+        if(mBridgeEnabled) drainBridge();
         if (rc != OK) {
             ALOGE("Could not close camera %s: %d", mCameraId.c_str(), rc);
         }
         mDevice = nullptr;
+        if(mBridgeEnabled) {Mutex::Autolock lock(mBridgeLock);mBridgeConfigured=false;}
     }
 }
 
