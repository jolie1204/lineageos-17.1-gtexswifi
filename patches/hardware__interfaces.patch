+bool CameraDevice::releaseBridgeFrame(uint32_t id,uint32_t index) {
+    bool recognized=false;
+    {
+        Mutex::Autolock lock(mBridgeLock);
+        recognized=mBridgeMemoryIds.count(id)!=0;
+        if(!recognized) return false;
+        for(auto& pool:mBridgePools) if(pool->id==id) {
+            if(index>=pool->busy.size() || !pool->busy[index])
+                ALOGE("GTEX bridge duplicate/invalid release id=%u index=%u",id,index);
+            else pool->busy[index]=false;
