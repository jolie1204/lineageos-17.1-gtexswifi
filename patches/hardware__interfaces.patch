diff --git a/camera/device/1.0/default/GtexRecordingBridge.h b/camera/device/1.0/default/GtexRecordingBridge.h
new file mode 100644
index 0000000..f2b2ed7
--- /dev/null
+++ b/camera/device/1.0/default/GtexRecordingBridge.h
@@ -0,0 +1,29 @@
+#pragma once
+#include <stddef.h>
+#include <stdint.h>
+#include <string.h>
+namespace gtex_recording {
+// Descriptor geometry/stride must originate from a registered producer buffer.
+inline bool nv21ToI420(const uint8_t* src, size_t srcBytes, size_t stride,
+        size_t srcWidth, size_t srcHeight, size_t cropX, size_t cropY,
+        size_t width, size_t height, uint8_t* dst, size_t dstBytes) {
+    if (!src || !dst || !width || !height || width > 1280 || height > 720 ||
+            !srcWidth || !srcHeight || srcWidth > 4096 || srcHeight > 4096 ||
+            ((stride|srcWidth|srcHeight|cropX|cropY|width|height)&1) ||
+            stride < srcWidth || stride > 8192 || cropX > srcWidth || cropY > srcHeight ||
+            width > srcWidth-cropX || height > srcHeight-cropY) return false;
+    const size_t sourceSize = stride * srcHeight * 3 / 2;
+    const size_t outputSize = width * height * 3 / 2;
+    if (srcBytes < sourceSize || dstBytes < outputSize) return false;
+    for (size_t y=0;y<height;++y)
+        memcpy(dst+y*width,src+(cropY+y)*stride+cropX,width);
+    uint8_t* u=dst+width*height;
+    uint8_t* v=u+width*height/4;
+    const uint8_t* vu=src+stride*srcHeight+(cropY/2)*stride+cropX;
+    for (size_t y=0;y<height/2;++y) for (size_t x=0;x<width/2;++x) {
+        v[y*(width/2)+x]=vu[y*stride+2*x];
+        u[y*(width/2)+x]=vu[y*stride+2*x+1];
+    }
+    return true;
+}
+} // namespace gtex_recording
