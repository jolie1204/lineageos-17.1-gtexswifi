diff --git a/hci/src/hci_layer.cc b/hci/src/hci_layer.cc
index 79c44e0..05779df 100644
--- a/hci/src/hci_layer.cc
+++ b/hci/src/hci_layer.cc
@@ -619,9 +619,27 @@ static bool filter_incoming_event(BT_HDR* packet) {
           __func__, opcode);
     } else {
       update_command_response_timer();
-      if (wait_entry->status_callback)
+      if (wait_entry->status_callback) {
         wait_entry->status_callback(status, wait_entry->command,
                                     wait_entry->context);
+      } else if (wait_entry->complete_future && status != HCI_SUCCESS) {
+        // Rejected synchronous commands can return Command Status instead of
+        // Command Complete. Resolve the future with the same error status;
+        // otherwise its caller waits forever after this entry is removed.
+        BT_HDR* response = static_cast<BT_HDR*>(
+            buffer_allocator->alloc(sizeof(BT_HDR) + 6));
+        response->event = packet->event;
+        response->len = 6;
+        response->offset = 0;
+        response->layer_specific = 0;
+        uint8_t* response_stream = response->data;
+        UINT8_TO_STREAM(response_stream, HCI_COMMAND_COMPLETE_EVT);
+        UINT8_TO_STREAM(response_stream, 4);
+        UINT8_TO_STREAM(response_stream, credits);
+        UINT16_TO_STREAM(response_stream, opcode);
+        UINT8_TO_STREAM(response_stream, status);
+        future_ready(wait_entry->complete_future, response);
+      }
     }
 
     goto intercepted;
